<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemDefinitionGroup>
    <ClCompile><AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)sdk;$(MSBuildThisFileDirectory)sdk\SDK;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories><PreprocessorDefinitions>;UNICODE;_UNICODE;NOMINMAX;WIN32_LEAN_AND_MEAN;%(PreprocessorDefinitions)</PreprocessorDefinitions><AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions></ClCompile>
    <Link><AdditionalDependencies>advapi32.lib;avrt.lib;cfgmgr32.lib;comctl32.lib;crypt32.lib;gdi32.lib;newdev.lib;ole32.lib;propsys.lib;setupapi.lib;shell32.lib;user32.lib;uuid.lib;wintrust.lib;%(AdditionalDependencies)</AdditionalDependencies></Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="$(MSBuildThisFileDirectory)sdk\SDK\AudioLink.cpp"><ObjectFileName>$(IntDir)TitanTitanAudioLink_%(Filename).obj</ObjectFileName></ClCompile>
  </ItemGroup>
</Project>
